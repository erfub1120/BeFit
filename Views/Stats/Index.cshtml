@model IEnumerable<BeFit.Models.ExerciseStats>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Statistics</title>
    <style>
        body {
            font-family: sans-serif;
            background: #f7f7f7;
            margin: 0;
            padding: 40px;
            color: #333;
        }

        .container {
            max-width: 900px;
            margin: auto;
        }

        h2 {
            font-size: 26px;
            margin-bottom: 20px;
        }

        .return-btn {
            display: inline-block;
            padding: 10px 16px;
            border-radius: 8px;
            background: #fff;
            color: #333;
            text-decoration: none;
            font-size: 14px;
            transition: opacity 0.2s;
        }

            .return-btn:hover {
                opacity: 0.2;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        th, td {
            padding: 12px 16px;
            font-size: 15px;
        }

        th {
            background: #fafafa;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        tr + tr td {
            border-top: 1px solid #eee;
        }
    </style>
</head>
<body>
    <h2>Exercise Statistics in last 4 weeks</h2>
    <a asp-controller="Home" asp-action="Index" class="return-btn">Back Home</a>

    <table class="table">
        <thead>
            <tr>
                <th>Exercise</th>
                <th>Times performed</th>
                <th>Total repetitions</th>
                <th>Average load</th>
                <th>Max load</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.ExerciseTypeName</td>
                    <td>@s.TimesPerformed</td>
                    <td>@s.TotalRepetitions</td>
                    <td>@String.Format("{0:0.##}", s.AverageLoad)</td>
                    <td>@String.Format("{0:0.##}", s.MaxLoad)</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>