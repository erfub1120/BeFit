@model IEnumerable<BeFit.Models.ExerciseLog>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Exercise Logs</title>
    <style>
        body {
            font-family: sans-serif;
            background: #f7f7f7;
            margin: 0;
            padding: 40px;
            color: #333;
        }

        .container {
            max-width: 900px;
            margin: auto;
        }

        h2 {
            font-size: 26px;
            margin-bottom: 20px;
        }

        .create-btn {
            display: inline-block;
            padding: 10px 16px;
            border-radius: 8px;
            background: #000;
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            transition: opacity 0.2s;
            margin-bottom: 20px;
        }

            .create-btn:hover {
                opacity: 0.8;
            }

        .return-btn {
            display: inline-block;
            padding: 10px 16px;
            border-radius: 8px;
            background: #fff;
            color: #333;
            text-decoration: none;
            font-size: 14px;
            transition: opacity 0.2s;
        }

            .return-btn:hover {
                opacity: 0.2;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        th, td {
            padding: 12px 16px;
            font-size: 15px;
        }

        th {
            background: #fafafa;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

        tr + tr td {
            border-top: 1px solid #eee;
        }

        .action-links a {
            margin-right: 10px;
            font-size: 14px;
            text-decoration: none;
            color: #000;
            padding: 6px 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            transition: opacity 0.2s;
        }

            .action-links a:hover {
                opacity: 0.7;
            }
    </style>
</head>
<body>
    <div class="container">
        <h2>Exercise Logs</h2>
        <a asp-action="Create" class="create-btn">Create New</a>
        <a asp-controller="Home" asp-action="Index" class="return-btn">Back Home</a>

        <table>
            <thead>
                <tr>
                    <th>Exercise Type</th>
                    <th>Training Session</th>
                    <th>Weight</th>
                    <th>Sets</th>
                    <th>Reps</th>
                    <th>Exercised By</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.ExerciseType.Name)</td>
                        <td>@item.TrainingSession.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@Html.DisplayFor(modelItem => item.Weight)</td>
                        <td>@Html.DisplayFor(modelItem => item.Sets)</td>
                        <td>@Html.DisplayFor(modelItem => item.Reps)</td>
                        <td>@Html.DisplayFor(modelItem => item.ExercisedBy.UserName)</td>
                        <td class="action-links">
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>

